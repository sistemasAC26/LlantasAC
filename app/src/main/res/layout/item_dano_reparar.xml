<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="top">

        <CheckBox
            android:id="@+id/chkDano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#64748B"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvDanoPunto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Birlos (Leve)"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/tvStatusBadge"/>

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reparacion_pendiente"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#EF4444"
                    android:background="@drawable/badge_bg_red"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/tvDanoTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Etiquetas: Birlo faltante"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvDanoNota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#64748B"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/btnVerFoto"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="@string/reparacion_evidencia_btn"
                android:textAllCaps="false"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#2563EB"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="6dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
