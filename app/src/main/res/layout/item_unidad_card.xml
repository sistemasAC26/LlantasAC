<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/input_bg"
    android:padding="16dp"
    android:layout_margin="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Lado Izquierdo (Nombres y Ruta) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/llGps">

            <TextView
                android:id="@+id/tvNombres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/N / S/N"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/tvRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- a -"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Lado Derecho (GPS Badge y Ubicación) -->
        <LinearLayout
            android:id="@+id/llGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_alignParentEnd="true">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardBadgeGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1F5F9">

                <TextView
                    android:id="@+id/tvBadgeGps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buscando..."
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvUbicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="10sp"
                android:textColor="#64748B"
                android:layout_marginTop="4dp"
                android:maxWidth="160dp"
                android:gravity="end"
                android:maxLines="2"/>
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:layout_marginVertical="12dp"/>

    <!-- Detalles -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Tipo de Carga" android:textSize="12sp" android:textColor="#6B7280"/>
        <TextView android:id="@+id/tvTipoCarga" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Estado" android:textSize="12sp" android:textColor="#6B7280"/>
        <TextView android:id="@+id/tvEstadoCarga" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="vacia" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Producto" android:textSize="12sp" android:textColor="#6B7280"/>
        <TextView android:id="@+id/tvProducto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937"/>
    </LinearLayout>

    <!-- Botón Inferior -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBtnAccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F1F5F9">

        <TextView
            android:id="@+id/btnAccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingVertical="12dp" />
    </androidx.cardview.widget.CardView>

</LinearLayout>